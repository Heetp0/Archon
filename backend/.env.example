# =============================================================================
# Archon Backend — Environment Variables Template
# Copy this file to .env and fill in your values.
# =============================================================================

# [REQUIRED] Workspace & Server
WORKSPACE_ROOT=~/archon-workspace
DAEMON_PORT=8765

# [REQUIRED] Authentication
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_use_a_32_char_random_string_here

# [REQUIRED] LLM API Keys — at least ONE required
# Groq (free): https://console.groq.com/keys
GROQ_API_KEY=
# Google Gemini (free): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# [OPTIONAL] Additional LLM fallback providers
# CEREBRAS_API_KEY=
# OPENROUTER_API_KEY=
# MISTRAL_API_KEY=
# DEEPSEEK_API_KEY=

# [OPTIONAL] Web Search (Research Mode) — https://tavily.com/
# TAVILY_API_KEY=

# [OPTIONAL] Local Embeddings (Ollama)
# Run: ollama pull nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434

# [OPTIONAL] Handwriting OCR — MyScript iink
# Get keys: https://developer.myscript.com/
# MYSCRIPT_APP_ID=
# MYSCRIPT_HMAC_KEY=

# [OPTIONAL] Tesseract OCR path (fallback for handwriting)
# TESSERACT_CMD=tesseract
# Windows: TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# [OPTIONAL] Google Calendar OAuth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Rate limits (free tier):
#   Groq: 30 req/min  |  Gemini: 15 req/min  |  Cerebras: generous
# Fallback chain: Groq -> Gemini -> Cerebras -> OpenRouter
